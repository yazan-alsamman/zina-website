# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL connection (docker-compose defaults shown)
DATABASE_URL="postgresql://zina:zina@localhost:5432/zina?schema=public"

# Host port for the docker-compose database (change if 5432 is taken)
POSTGRES_PORT=5432

# Public site origin, used for metadata / canonical URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin account email (used by the admin seed in a later step)
ADMIN_EMAIL="admin@example.com"
