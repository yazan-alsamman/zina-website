# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL connection (docker-compose defaults shown)
DATABASE_URL="postgresql://zina:zina@localhost:5432/zina?schema=public"

# Host port for the docker-compose database (change if 5432 is taken)
POSTGRES_PORT=5432

# Public site origin, used for metadata / canonical URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin sessions: a long random secret (at least 32 characters), e.g. `openssl rand -base64 48`
AUTH_SECRET=""

# First admin, created by `npm run db:seed` only when no admin exists yet
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Uploaded media: stored on this server, served at PUBLIC_MEDIA_URL
UPLOAD_DIR="./storage/uploads"
PUBLIC_MEDIA_URL="/media"

# Business WhatsApp number for "Order on WhatsApp" and WhatsApp checkout: international
# format, digits only (country code first, no "+" or spaces), e.g. 971500000000
BUSINESS_WHATSAPP=""

# Order emails (optional). Without SMTP_HOST / SMTP_FROM emails are skipped and logged;
# ordering never depends on email.
ORDER_NOTIFY_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Zina Al Mokri <orders@example.com>"

# Instagram feed (Instagram API with Instagram Login), see docs/instagram-setup.md.
# Long-lived token (60 days); the app refreshes it automatically and keeps the current one
# (encrypted) in the database, so this value only seeds it. Optional numeric account id.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""

# Optional key for the encrypted Instagram token in the database (32+ characters,
# e.g. `openssl rand -hex 32`). Without it the key is derived from AUTH_SECRET.
INSTAGRAM_ENCRYPTION_KEY=""

# Shared secret for cron endpoints (POST /api/cron/instagram), e.g. `openssl rand -hex 32`
CRON_SECRET=""

# Set to "true" to seed sample brands, products and orders (local testing only)
SEED_SAMPLE_DATA="false"
