// Prisma ORM 7: connection URL lives in prisma.config.ts; the runtime client uses @prisma/adapter-pg.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_REVIEW
  AWAITING_PAYMENT
  APPROVED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
  WHATSAPP
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  website   String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameEn        String
  nameAr        String
  descriptionEn String?        @db.Text
  descriptionAr String?        @db.Text
  reviewEn      String?        @db.Text
  reviewAr      String?        @db.Text
  /// Owner's rating, e.g. 4.5 (0.0–5.0)
  rating        Decimal?       @db.Decimal(2, 1)
  price         Decimal        @db.Decimal(10, 2)
  /// ISO 4217 code
  currency      String         @default("USD") @db.Char(3)
  /// null = stock not tracked
  stock         Int?
  isPublished   Boolean        @default(false)
  /// Shown in the landing "The Edit" (published products only), ordered by featuredOrder
  isFeatured    Boolean        @default(false)
  featuredOrder Int?
  brandId       String
  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  orderItems    OrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isPublished])
  @@index([brandId])
  @@index([isFeatured, featuredOrder])
}

model ProductImage {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Media path of the default (largest WebP) rendition, relative to PUBLIC_MEDIA_URL
  url       String
  altEn     String
  altAr     String
  /// 0 = cover image
  sortOrder Int         @default(0)
  assetId   String?
  asset     MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([assetId])
}

/// An uploaded image, stored on our own server under UPLOAD_DIR and processed into responsive
/// AVIF + WebP renditions. Files live in `dir`: the metadata-stripped original plus
/// w{width}.avif / w{width}.webp for every width in `widths`.
model MediaAsset {
  id            String         @id @default(cuid())
  /// Directory relative to UPLOAD_DIR, e.g. "2026/10/clx123abc"
  dir           String
  /// File name of the stripped original inside `dir`, e.g. "original.jpg"
  original      String
  mime          String
  width         Int
  height        Int
  bytes         Int
  /// Tiny base64 WebP data URI, used as the blur placeholder
  lqip          String         @db.Text
  widths        Int[]
  productImages ProductImage[]
  createdAt     DateTime       @default(now())
}

model Order {
  id             String        @id @default(cuid())
  /// Human-readable reference shown to customers, e.g. "ZAM-2026-000123"
  orderNumber    String        @unique
  /// Random secret (base64url) that unlocks the customer's tracking page
  publicToken    String        @unique
  /// Sent by the client with the checkout form so a double submit creates one order
  idempotencyKey String?       @unique
  status         OrderStatus   @default(PENDING_REVIEW)
  customerName   String
  email          String
  phone          String
  whatsapp       String?
  /// ISO 3166-1 alpha-2
  country        String        @db.Char(2)
  city           String
  addressLine1   String
  addressLine2   String?
  postalCode     String?
  notes          String?       @db.Text
  paymentMethod  PaymentMethod
  subtotal       Decimal       @db.Decimal(10, 2)
  /// null until an admin reviews the order and sets shipping
  shippingFee    Decimal?      @db.Decimal(10, 2)
  /// null until shippingFee is known
  total          Decimal?      @db.Decimal(10, 2)
  /// ISO 4217 code
  currency       String        @db.Char(3)
  /// UI locale the order was placed in ("en" | "ar")
  locale         String
  items          OrderItem[]
  events         OrderEvent[]
  trackingNumber String?
  carrier        String?
  cancelReason   String?       @db.Text
  /// Secure payment link pasted by an admin for card orders
  paymentUrl     String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  approvedAt     DateTime?
  paidAt         DateTime?

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Product name at time of purchase, so history survives renames
  productNameSnapshot String
  unitPrice           Decimal @db.Decimal(10, 2)
  quantity            Int
  /// Units taken from Product.stock when the order was approved (0 = none, e.g. unlimited
  /// stock). Cancelling gives exactly this back.
  reservedQuantity    Int     @default(0)

  @@index([orderId])
  @@index([productId])
}

/// Audit trail of every status change (and notable admin edits) on an order.
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// null for the event that records the order being placed
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.Text
  adminId    String?
  admin      AdminUser?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model AdminUser {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  /// Bumped on password change; sessions carrying an older version are rejected
  sessionVersion Int          @default(0)
  orderEvents    OrderEvent[]
  createdAt      DateTime     @default(now())
}
